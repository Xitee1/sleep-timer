<?xml version="1.0" encoding="utf-8"?>
<!-- Material You: derive the widget palette from the user's wallpaper on Android 12+.
     The shades are fixed (not day/night dependent), so the widget stays dark like
     the app while picking up the dynamic hue. -->
<resources>
    <color name="widget_background">@android:color/system_neutral1_900</color>
    <color name="widget_accent">@android:color/system_accent1_200</color>
    <color name="widget_text">@android:color/system_neutral1_50</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_200</color>
</resources>
